<%= form_with(model: event, local:true,class:"needs-validation")do|f|%>
  <%if event.errors.any?%>
    <div class="alert alert-danger">
      <h5><%=pluralize(event.errors.count,"個")%>のエラーがあります:</h5>
      <ul>
        <% event.errors.full_messages.eachdo|message|%>
          <li><%= message%></li>
        <%end%>
      </ul>
    </div>
  <%end%>

  <div class="mb-3">
    <%= f.label:name,class:"form-label"%>
    <%= f.text_field:name,class:"form-control", placeholder:"例: Rails勉強会 #1"%>
  </div>

  <div class="mb-3">
    <%= f.label:description,class:"form-label"%>
    <%= f.text_area:description, rows:5,class:"form-control",
        placeholder:"イベントの詳細を入力してください"%>
  </div>

  <div class="mb-3">
    <%= f.label:location,class:"form-label"%>
    <%= f.text_field:location,class:"form-control", placeholder:"例: 東京都渋谷区..."%>
  </div>

  <div class="mb-3">
    <%= f.label:start_at,class:"form-label"%>
    <%= f.datetime_local_field:start_at,class:"form-control"%>
  </div>

  <div class="mb-3">
    <%= f.label:end_at,class:"form-label"%>
    <%= f.datetime_local_field:end_at,class:"form-control"%>
  </div>

  <%= f.submitclass:"btn btn-primary"%>
<%end%>