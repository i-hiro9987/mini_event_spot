<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>イベント一覧</h1>
  <%if logged_in?%>
    <%=link_to"新規作成", new_event_path,class:"btn btn-primary"%>
  <%end%>
</div>

<%if@events.empty?%>
  <div class="alert alert-info">
    イベントがまだありません。
  </div>
<% else%>
  <div class="row">
    <%@events.eachdo|event|%>
      <div class="col-md-6 mb-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title"><%=link_to event.name, event%></h5>
            <p class="card-text">
              <small class="text-muted">
                <i class="bi bi-calendar"></i> <%= l event.start_at,format::long%>
              </small><br>
              <small class="text-muted">
                <i class="bi bi-geo-alt"></i> <%= event.location%>
              </small><br>
              <small class="text-muted">
                主催: <%= event.user.name%>
              </small>
            </p>
            <%=link_to"詳細を見る", event,class:"btn btn-sm btn-outline-primary"%>
          </div>
        </div>
      </div>
    <%end%>
  </div>
<%end%>