<!DOCTYPE html>
<html>
  <head>
    <title>MiniEventSpot</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap CSS (6-2-4) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- ナビゲーションバー -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <%= link_to "MiniEventSpot", root_path, class: "navbar-brand" %>
        <div class="navbar-nav ms-auto">
          <% if logged_in? %>
            <span class="navbar-text me-3">
              <%= current_user.name %>
            </span>
            <%= link_to "ログアウト", logout_path, method: :delete, class: "btn btn-outline-light" %>
          <% else %>
            <%= link_to "GitHubでログイン", "/auth/github", method: :post, class: "btn btn-light" %>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- フラッシュメッセージ -->
    <div class="container mt-3">
      <% flash.each do |type, message| %>
        <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
    </div>

    <!-- メインコンテンツ -->
    <div class="container mt-4">
      <%= yield %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>